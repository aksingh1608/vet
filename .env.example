# Copy to .env and fill in. Never commit .env.

# Required from Phase 2
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=
BACKUP_LLM_API_KEY=

# Models
JUDGE_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5

# Budgets (seconds)
VET_PRODUCT_BUDGET_S=180
VET_COLLECTOR_TIMEOUT_S=45
VET_FETCH_TIMEOUT_S=15

# Contact shown in the User-Agent (a URL or email you are happy to expose to site owners)
VET_CONTACT=

# Per-host minimum seconds between requests, JSON object, merged over the defaults in config.py
# VET_HOST_INTERVALS={"api.tavily.com": 0.25}

# Verdict label mapping to the organiser's labels, JSON objects (internal label -> output label)
# VET_REAL_ALIVE_LABELS={"yes": "yes", "unclear": "unclear", "no": "no"}
# VET_TRUST_LABELS={"trust": "trust", "caution": "caution", "do_not_trust": "do_not_trust"}

# Paths
VET_CACHE_PATH=.cache/fetch.sqlite
VET_RUNS_DIR=runs
