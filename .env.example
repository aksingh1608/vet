# Copy to .env and fill in. Never commit .env.

# Required from Phase 2
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional
COMPANIES_HOUSE_API_KEY=
BACKUP_LLM_API_KEY=

# Models
JUDGE_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5

# Budgets (seconds)
VET_PRODUCT_BUDGET_S=180
VET_COLLECTOR_TIMEOUT_S=45
VET_FETCH_TIMEOUT_S=15

# Contact shown in the User-Agent (a URL or email you are happy to expose to site owners)
VET_CONTACT=

# Per-host politeness, JSON object merged over DEFAULT_HOST_POLICIES in config.py
# VET_HOST_POLICIES={"api.tavily.com": {"min_interval_s": 0.25}}

# Tavily search depth: basic (1 credit) by default; set to true for advanced (2 credits)
VET_TAVILY_ADVANCED=false

# Verdict label mapping to the organiser's labels, JSON objects (internal label -> output label)
# VET_REAL_ALIVE_LABELS={"yes": "yes", "unclear": "unclear", "no": "no"}
# VET_TRUST_LABELS={"trust": "trust", "caution": "caution", "do_not_trust": "do_not_trust"}

# Paths
VET_CACHE_PATH=.cache/fetch.sqlite
VET_RUNS_DIR=runs

# Phase 4: calibration and output
VET_BREACH_RECENT_YEARS=3
VET_OUTPUT_FORMAT=json
# Reuse LLM answers for identical inputs (reproducible reruns). false = always ask the model.
VET_LLM_CACHE=true
# Organiser label file columns, e.g. {"url": "product_url", "real_alive": "alive", "trust": "trust_level"}
VET_LABEL_COLUMNS=
