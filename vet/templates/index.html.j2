{% extends "base.html.j2" %}
{% block title %}vet run {{ run_id }}{% endblock %}
{% block body %}
<h1>vet run {{ run_id }}</h1>
<p class="muted">{{ pages | length }} product{{ "" if pages | length == 1 else "s" }}</p>
<table>
  <tr><th>Product</th><th>Real &amp; alive</th><th>Trust</th><th class="num">Reasons</th>
      <th class="num">Findings</th><th class="num">Seconds</th></tr>
  {% for p in pages %}
  <tr>
    <td><a href="{{ p.slug }}.html">{{ p.v.product_url }}</a></td>
    <td><span class="pill {{ p.v.real_alive }}">{{ p.v.real_alive }}</span></td>
    <td><span class="pill {{ p.v.trust }}">{{ p.v.trust | replace("_", " ") }}</span></td>
    <td class="num">{{ p.v.reasons | length }}</td>
    <td class="num">{{ p.v.findings | length }}</td>
    <td class="num">{{ "%.0f"|format(p.r.seconds) }}</td>
  </tr>
  {% endfor %}
</table>
{% endblock %}
