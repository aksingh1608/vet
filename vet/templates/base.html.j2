<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{% block title %}vet{% endblock %}</title>
<style>
  /* Self-contained: no external fonts, scripts or stylesheets (works offline on a projector). */
  :root {
    --ink: #111418; --muted: #4a5260; --line: #d9dce2; --bg: #f6f7f9; --card: #ffffff;
    --good: #146c43; --good-bg: #e3f3ea; --warn: #8a5300; --warn-bg: #fdf0d2;
    --bad: #b42318; --bad-bg: #fde8e6; --neutral-bg: #eceef2; --accent: #1f4fd1;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 19px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue",
               Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  main { max-width: 1180px; margin: 0 auto; padding: 36px 28px 56px; }
  h1 { font-size: 40px; line-height: 1.15; margin: 0; letter-spacing: -.01em; }
  h2 { font-size: 26px; margin: 44px 0 14px; letter-spacing: -.005em; }
  h3 { font-size: 21px; margin: 22px 0 10px; color: var(--muted); }
  a { color: var(--accent); text-underline-offset: 3px; }
  .muted { color: var(--muted); }
  .small { font-size: 16px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
          padding: 20px 24px; }
  .pill { display: inline-block; padding: 4px 14px; border-radius: 999px; font-weight: 700;
          font-size: 16px; background: var(--neutral-bg); white-space: nowrap; }
  .yes, .trust { background: var(--good-bg); color: var(--good); }
  .unclear, .caution { background: var(--warn-bg); color: var(--warn); }
  .no, .do_not_trust { background: var(--bad-bg); color: var(--bad); }
  table { width: 100%; border-collapse: collapse; background: var(--card);
          border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  th { font-weight: 700; color: var(--muted); font-size: 15px; text-transform: uppercase;
       letter-spacing: .04em; background: var(--neutral-bg); }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .back { font-size: 17px; margin: 0 0 18px; }
  footer { margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--line);
           color: var(--muted); font-size: 16px; }
  details summary { cursor: pointer; color: var(--muted); font-size: 17px; }
  {% block style %}{% endblock %}
</style>
</head>
<body>
<main>
{% block body %}{% endblock %}
<footer>
  <p>Generated by <strong>vet</strong>. Reasons are observations from records and independent
  sources; every reason and finding links to the page that states it.</p>
  <p>Breach data: <a href="{{ hibp_url }}" rel="noopener noreferrer">Have I Been Pwned</a>.</p>
</footer>
</main>
</body>
</html>
