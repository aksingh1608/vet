<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{% block title %}vet{% endblock %}</title>
<style>
  :root {
    --ink: #1d2026; --muted: #5d6472; --line: #e3e5ea; --bg: #fafaf8; --card: #fff;
    --good: #1f7a4d; --good-bg: #e6f4ec; --warn: #9a6200; --warn-bg: #fdf3dc;
    --bad: #b3261e; --bad-bg: #fbe9e7; --neutral-bg: #eef0f3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #e7e9ee; --muted: #a0a6b3; --line: #2e323b; --bg: #15171b; --card: #1c1f25;
      --good: #6fd19c; --good-bg: #173326; --warn: #f0c060; --warn-bg: #3a2e12;
      --bad: #ff8a80; --bad-bg: #3d1a18; --neutral-bg: #262a31;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 980px; margin: 0 auto; padding: 32px 20px 48px; }
  h1 { font-size: 24px; margin: 0 0 4px; word-break: break-all; }
  h2 { font-size: 16px; margin: 32px 0 10px; text-transform: uppercase; letter-spacing: .04em;
       color: var(--muted); }
  a { color: inherit; }
  .muted { color: var(--muted); }
  .small { font-size: 13px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
          padding: 16px 18px; }
  .labels { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0; }
  .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 600;
          font-size: 13px; background: var(--neutral-bg); }
  .yes, .trust { background: var(--good-bg); color: var(--good); }
  .unclear, .caution { background: var(--warn-bg); color: var(--warn); }
  .no, .do_not_trust { background: var(--bad-bg); color: var(--bad); }
  .positive { color: var(--good); } .negative { color: var(--bad); }
  ol.reasons { padding-left: 22px; margin: 0; }
  ol.reasons li { margin: 0 0 14px; }
  .quote { margin: 4px 0 0; padding-left: 10px; border-left: 3px solid var(--line);
           color: var(--muted); font-size: 13px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  th { font-weight: 600; color: var(--muted); font-size: 12px; text-transform: uppercase; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .flag { color: var(--bad); font-weight: 600; }
  footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line);
           color: var(--muted); font-size: 13px; }
  details summary { cursor: pointer; color: var(--muted); }
</style>
</head>
<body>
<main>
{% block body %}{% endblock %}
<footer>
  <p>Generated by <strong>vet</strong>. Reasons are observations from records and independent
  sources; every reason and finding links to the page that states it.</p>
  <p>Breach data: <a href="{{ hibp_url }}" rel="noopener noreferrer">Have I Been Pwned</a>.</p>
</footer>
</main>
</body>
</html>
